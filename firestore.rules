rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------- HELPERS ----------------
    function signedIn() {
      return request.auth != null;
    }

    function myUid() {
      return request.auth.uid;
    }

    function myProfile() {
      return get(/databases/$(database)/documents/users/$(myUid())).data;
    }

    /** 
     * isAdmin: User must be signed in, have a profile,
     * role must be 'admin', and status must be 'active'.
     */
    function isAdmin() {
      return signedIn()
        && myProfile() != null
        && myProfile().role == "admin"
        && myProfile().status == "active";
    }

    /**
     * isActiveUser: User must be signed in, have a profile,
     * and status must be exactly 'active'.
     */
    function isActiveUser() {
      return signedIn()
        && myProfile() != null
        && myProfile().status == "active";
    }

    // ---------------- USERS ----------------
    match /users/{uid} {
      allow read: if isAdmin() || (signedIn() && uid == myUid());

      // Only admins can create users, OR a new user can create their own profile during signup.
      allow create: if isAdmin() || (signedIn()
        && uid == myUid()
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role == "staff"
        && request.resource.data.status == "active");

      // Admin can update any field. User can only update specific non-sensitive fields.
      allow update: if isAdmin() || (signedIn()
        && uid == myUid()
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['name', 'displayName', 'photoURL', 'phone', 'updatedAt', 'emailVerified']));

      allow delete: if isAdmin();
    }

    // ---------------- INVENTORY ITEMS ----------------
    match /inventoryItems/{docId} {
      allow read: if isActiveUser();
      
      allow create, delete: if isAdmin();
      
      /**
       * Staff can update stock levels and sale metadata during sale/return transactions.
       * They are blocked from editing name, prices, SKUs, or suppliers.
       */
      allow update: if isAdmin() || (isActiveUser()
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly([
              'quantity', 'updatedAt', 'lastSoldAt', 'lastSaleAt',
              'soldCount', 'totalSold', 'salesCount',
              'lastSoldByUid', 'lastSoldByEmail',
              'updatedByUid', 'updatedByEmail',
              'lastUpdatedBy', 'lastUpdatedByEmail'
            ])
        && request.resource.data.quantity >= 0);
    }

    // ---------------- DOCUMENTS ----------------
    match /documents/{docId} {
      allow read: if isAdmin()
        || (isActiveUser() && resource.data.ownerUid == myUid());

      allow create: if isActiveUser()
        && request.resource.data.ownerUid == myUid()
        && request.resource.data.status == "pending";

      allow update: if isAdmin()
        || (isActiveUser()
            && resource.data.ownerUid == myUid()
            && resource.data.status == "pending"
            && request.resource.data.status == "pending");

      allow delete: if isAdmin();
    }

    // ---------------- AUDIT LOGS ----------------
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      
      allow create: if isActiveUser()
        && (request.resource.data.performedByUid == myUid() || request.resource.data.uid == myUid());
        
      allow update, delete: if false;
    }

    // ---------------- SALES ----------------
    match /sales/{docId} {
      allow read: if isActiveUser();
      allow create: if isActiveUser();
      allow update, delete: if isAdmin();
    }

    // ---------------- CUSTOMERS ----------------
    match /customers/{docId} {
      allow read: if isActiveUser();
      // Allow staff to create customers during sale checkout
      allow create: if isActiveUser();
      // Admin manages existing customers
      allow update, delete: if isAdmin();
    }

    // ---------------- SUPPLIERS ----------------
    match /suppliers/{docId} {
      allow read: if isActiveUser();
      allow create, update, delete: if isAdmin();
    }

    // ---------------- NOTIFICATIONS ----------------
    match /notifications/{docId} {
      // Allow broader read for notifications so de-duplication queries in actions work properly.
      // Privacy is still maintained by targeting, but de-dup checks need to see unread alerts.
      allow read: if signedIn();
      
      allow update: if isAdmin()
        || (isActiveUser() && (resource.data.targetUid == myUid() || resource.data.uid == myUid())
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead', 'readAt', 'status']));

      allow delete: if isAdmin();

      allow create: if isActiveUser();
    }

    // ---------------- LOGIN ACTIVITIES ----------------
    match /loginActivities/{docId} {
      allow read: if isAdmin();
      allow create: if isActiveUser();
      allow update, delete: if false;
    }

    // ---------------- ANOMALY ALERTS ----------------
    match /anomalyAlerts/{docId} {
      // Allow read for active users to support de-duplication checks during alert creation.
      allow read: if isAdmin() || isActiveUser();
      allow create: if isActiveUser();
      allow update: if isAdmin();
      allow delete: if false;
    }

    // ---------------- DEFAULT DENY ----------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
